# Dependencies
node_modules/
server/node_modules/

# Build outputs
dist/
build/
server/dist/
.vite/

# Local environment files - never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local
server/.env
server/.env.local
server/.env.development.local
server/.env.test.local
server/.env.production
server/.env.production.local
server/.env*.local

# Keep safe templates tracked
!.env.example
!server/.env.example

# Secret/key material
*.pem
*.key
*.p8
*.p12
*.cert
*.crt
*service-account*.json
*firebase-admin*.json

