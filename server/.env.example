# Runtime
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# Frontend origins allowed to call this API.
# Production: set CLIENT_URL to your live frontend and put any extra allowed origins in CLIENT_URLS.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# Database
DATABASE_URL=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_MAX_USES=7500
DISABLE_PERFORMANCE_INDEXES=false
ENABLE_LEGACY_ROUTE_TABLE_SETUP=false

# Firebase Admin
FIREBASE_WEB_API_KEY=
FIREBASE_PASSWORD_AUTH_TIMEOUT_MS=8000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_TIMEOUT_MS=3000
FIREBASE_AUTH_MAX_CONCURRENT=50
FIREBASE_AUTH_FAILURE_THRESHOLD=5
FIREBASE_AUTH_RECOVERY_TIMEOUT_MS=15000
ALLOW_LEGACY_PASSWORD_SESSIONS=false
FIREBASE_AUTH_SUCCESS_THRESHOLD=2

# Email / Brevo SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=SplitVerse <onboarding@resend.dev>
SUPPORT_EMAIL=
CONTACT_EMAIL=

# Body limits
JSON_BODY_LIMIT=100kb
RAZORPAY_WEBHOOK_BODY_LIMIT=1mb

# Rate limits
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=700
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=80
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_AUTH_RATE_LIMIT_MAX=10
PUBLIC_FORM_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_FORM_RATE_LIMIT_MAX=8
PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=30
RAZORPAY_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
RAZORPAY_WEBHOOK_RATE_LIMIT_MAX=120

# Setup / dev-only routes
ENABLE_SETUP_ROUTES=false
ALLOW_PRODUCTION_SETUP_ROUTES=false
SETUP_ROUTE_SECRET=
ENABLE_DEV_PAYMENT_APPROVAL=false
DEV_PAYMENT_APPROVAL_SECRET=
ENABLE_DEV_WALLET_TOP_UP=false

# Profile photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_FOLDER=splitverse/profile-photos

# Password reset OTP
LOGIN_OTP_EXPIRY_MS=600000
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_MAX_REQUESTS=5
LOGIN_OTP_REQUEST_WINDOW_MINUTES=15
LOGIN_OTP_MAX_RESENDS=3
LOGIN_OTP_RESEND_COOLDOWN_MS=30000
LOGIN_OTP_PEPPER=
PASSWORD_RESET_OTP_EXPIRY_MS=600000
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_MAX_REQUESTS=3
PASSWORD_RESET_OTP_WINDOW_MINUTES=15
PASSWORD_RESET_OTP_PEPPER=make-this-long-random-secret

# Wallet PIN reset OTP
WALLET_PIN_RESET_OTP_EXPIRY_MS=600000
WALLET_PIN_RESET_OTP_MAX_ATTEMPTS=5
WALLET_PIN_RESET_OTP_MAX_REQUESTS=3
WALLET_PIN_RESET_OTP_WINDOW_MINUTES=15
WALLET_PIN_RESET_OTP_PEPPER=make-this-long-random-secret

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WALLET_TOP_UP_MAX=100000

# Logging
HEALTH_INCLUDE_DIAGNOSTICS=false
LOG_REQUESTS=true

# HTTP server lifecycle
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000
